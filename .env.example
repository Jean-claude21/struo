# Struo — every variable, without values. Copy to .env (never committed).
# Public address of the app (no trailing slash).
APP_BASE_URL=http://localhost:3000
APP_ENV=development
# Application connection: role struo_app (cannot bypass RLS).
DATABASE_URL=
# Owner connection: migrations, seed, platform console.
DATABASE_OWNER_URL=
# Password given to the struo_app role by `pnpm db:migrate`.
APP_DB_PASSWORD=
# Better Auth signing secret (32+ random bytes).
BETTER_AUTH_SECRET=
# Key used to encrypt each company's payment secrets at rest (32 random bytes, base64).
SECRETS_KEY=
# Comma-separated e-mails allowed into /console.
PLATFORM_ADMIN_EMAILS=
# Object storage (S3-compatible). Empty: files are stored on disk under STORAGE_DIR.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_DIR=./storage
# E-mail (Resend). Empty: e-mails are written to the log.
RESEND_API_KEY=
MAIL_FROM=
# WhatsApp Cloud API. Empty: messages are simulated (logged).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# AI (OpenAI). Empty: drafting uses templates.
OPENAI_API_KEY=
OPENAI_MODEL=
# Struo Intelligence (spec 034): the assistant model on the company key (default gpt-6-luna).
OPENAI_AGENT_MODEL=
# Sign in with ChatGPT: the client OpenAI issues to Struo in its partner programme (empty until then).
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=
# Chariow (subscriptions sold as licences): secret API key with licenses.read and licenses.write.
CHARIOW_API_KEY=
# Scheduled jobs in this process (true/false).
JOBS_ENABLED=true
# Platform payment account (spec 017). Empty: simulator in test environments, no online payment in production.
PLATFORM_MONEROO_SECRET_KEY=
PLATFORM_MONEROO_WEBHOOK_SECRET=

# Monitoring (spec 041): error tracker (Sentry DSN) and cookieless audience (Umami); empty = off.
SENTRY_DSN=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
